DB_URL=jdbc:postgresql://localhost:5432/labo_anapath
DB_USERNAME=postgres
DB_PASSWORD=
JWT_SECRET=your-256-bit-secret-here
JWT_EXPIRATION=86400000
JWT_REFRESH=604800000

# Port de l'API publié sur l'hôte.
API_PORT=7001
# Port écouté par l'application dans le conteneur. Le changer suffit : le
# mapping et le healthcheck du compose s'y alignent automatiquement.
APP_PORT=7001

# ── Mail (SMTP) ────────────────────────────────────────────────────────────────
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_FROM=noreply@labo-anapath.bj
MAIL_FROM_NAME=Labo AnaPath

# Domaine partagé des cookies d'authentification.
# Vide si le front est servi depuis le même hôte que l'API.
# Sous-domaines distincts (api.caap.bj / new.caap.bj) : mettre .caap.bj
APP_COOKIE_DOMAIN=

# ── Chiffrement des fichiers stockés ────────────────────────────────────────
# Inutile en développement. Pour l'essayer : openssl rand -base64 32
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_ENCRYPTION_KEY=

# ── Passerelle SMS FluidPay ────────────────────────────────────────────────
# Les SMS (facture téléchargeable, résultat disponible) partent par FluidPay,
# qui les achemine via OurVoice. Contrat : docs/openapi.yaml, POST /api/v1/sms.
# NB : l'appel vocal ne passe pas par ici — FluidPay ne fait que du SMS. Il part
# vers l'API OurVoice directe, dont les identifiants vivent dans setting_apps
# (key_ourvoice, link_ourvoice_call), réglables depuis l'écran Paramètres.
FLUIDPAY_SMS_ENABLED=true
FLUIDPAY_SMS_BASE_URL=https://app.fluidpay.link
# Jeton Bearer du tableau de bord FluidPay. TANT QU'IL EST VIDE, les SMS
# repartent par l'API OurVoice directe (setting_apps.link_ourvoice_sms) : rien
# ne casse, mais la bascule n'a pas lieu.
FLUIDPAY_SMS_API_KEY=
# Clé de chiffrement (32 caractères), à côté de la clé d'API dans le tableau de
# bord. OBLIGATOIRE : le serveur refuse tout envoi SMS non chiffré, contrairement
# à ce que décrit docs/openapi.yaml. Sans elle, repli sur OurVoice.
FLUIDPAY_SMS_ENCRYPTION_KEY=
# Opérateur d'acheminement : ourvoice | lafricamobile.
FLUIDPAY_SMS_PROVIDER=ourvoice
# Expéditeur affiché, 11 caractères au plus. Vide = celui déclaré chez l'opérateur.
FLUIDPAY_SMS_SENDER=

# ── Lien public des factures envoyé par SMS ────────────────────────────────
# Adresse par laquelle un client joint l'API depuis son téléphone. C'est elle
# qui préfixe le lien de téléchargement du SMS : « localhost » y serait
# inutilisable. En développement, l'adresse de la machine sur le réseau local.
PUBLIC_BASE_URL=https://api.caap.bj
# Durée de vie du lien, en jours.
INVOICE_SHARE_LINK_TTL_DAYS=60

# ── Reprise des avis patients ─────────────────────────────────────────────
# Un compte-rendu validé après 18h ne déclenche aucun appel : on ne réveille pas
# un patient. Cette tâche rattrape ces avis le lendemain à l'ouverture.
# « - » désactive. Pour une recette : « 0 * * * * * » (toutes les minutes).
REPORT_NOTIFY_RETRY_CRON=0 0 8 * * *
