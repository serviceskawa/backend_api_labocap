# ─── Variables de production pour docker-compose ────────────────────────────
# Copie ce fichier en .env  ->  cp .env.prod.example .env
# puis remplis les valeurs. NE COMMITE PAS le .env rempli.

# ── Base de données ─────────────────────────────────────────────────────────
DB_NAME=labo_anapath
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=change_moi_mot_de_passe_fort

# ── Sécurité JWT ────────────────────────────────────────────────────────────
# Génère une clé forte :  openssl rand -base64 48
JWT_SECRET=change_moi_cle_256_bits
JWT_EXPIRATION=86400000
JWT_REFRESH=604800000

# ── Port exposé de l'API sur l'hôte ─────────────────────────────────────────
API_PORT=8080

# ── SMTP (production) ───────────────────────────────────────────────────────
MAIL_HOST=smtp.exemple.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@labo-anapath.bj
MAIL_FROM_NAME=Labo AnaPath

# Domaine partagé des cookies d'authentification.
# Vide si le front est servi depuis le même hôte que l'API.
# Sous-domaines distincts (api.caap.bj / new.caap.bj) : mettre .caap.bj
APP_COOKIE_DOMAIN=

# ── Chiffrement des fichiers stockés ────────────────────────────────────────
# Produire la clé :  openssl rand -base64 32
#
# ⚠ Une clé perdue rend les images chiffrées DÉFINITIVEMENT illisibles.
# En garder une copie hors du serveur (coffre de mots de passe, pli scellé) :
# un serveur réinstallé emporte son .env avec lui.
#
# Poser la clé D'ABORD, activer ENSUITE. L'ordre inverse fait échouer le
# démarrage — refus volontaire, préférable à une erreur sur chaque image.
STORAGE_ENCRYPTION_ENABLED=false
STORAGE_ENCRYPTION_KEY=

# ── Obligatoires : compose refuse de démarrer sans elles ──────────────────
# Adresse du front (lien de réinitialisation du mot de passe), sans / final.
APP_FRONT_URL=https://new.caap.bj
# Origines autorisées (CORS), séparées par des virgules.
APP_CORS_ALLOWED_ORIGINS=https://new.caap.bj
# Adresse publique de l'API : préfixe des liens envoyés par SMS.
PUBLIC_BASE_URL=https://api.caap.bj

# ── SMS par FluidPay (vide : repli sur OurVoice) ──────────────────────────
FLUIDPAY_SMS_API_KEY=
FLUIDPAY_SMS_ENCRYPTION_KEY=
FLUIDPAY_SMS_SENDER=CAAP

# ── Clé des secrets courts à remontrer (openssl rand -base64 32) ──────────
SECRETS_KEY=
